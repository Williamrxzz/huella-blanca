# Copiar como .env.local (que git ignora) y completar con los datos del proyecto
# de Supabase: Project Settings > API. Después de cambiarlo, reiniciar Vite.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "anon" (pública). Nunca poner acá la clave de servicio ni la de la API de Claude.
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON
