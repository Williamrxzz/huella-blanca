{
  "rewrites": [
    {
      "source": "/m/:codigo",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|WhatsApp|Twitterbot|TelegramBot|Slackbot|Slack-ImgProxy|LinkedInBot|Discordbot|Pinterestbot|SkypeUriPreview|Applebot|redditbot|Embedly|vkShare|Viber).*"
        }
      ],
      "destination": "/api/og?codigo=:codigo"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
